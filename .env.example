# ── 测试目标与执行环境 ──
# 本地 Runner 和服务器 Runner 都可以测试 https://www.science42.tech，
# 但登录态文件必须隔离：本地保存在工作区 ignored 目录，服务器保存在 /var/lib 下。

SCIENCE42_USER=
SCIENCE42_PASSWORD=

# 本地 Runner 测线上站（默认值，可省略）
# SCIENCE42_BASE_URL=https://www.science42.tech
# SCIENCE42_STORAGE_STATE=shared/auth/.auth/science42.json
# SCIENCE42_SESSION_STATE=shared/auth/.auth/science42-session.json

# 仅当需要测试本机 Science42 前端时才改为 localhost，并换用另一套状态文件
# SCIENCE42_BASE_URL=http://localhost:20163
# SCIENCE42_STORAGE_STATE=shared/auth/.auth/science42-local.json
# SCIENCE42_SESSION_STATE=shared/auth/.auth/science42-session-local.json

# 服务器 Runner 由 /etc/science42-synthetic-monitor/monitor.env 配置，状态文件示例：
# SCIENCE42_STORAGE_STATE=/var/lib/science42-synthetic-monitor/science42.json
# SCIENCE42_SESSION_STATE=/var/lib/science42-synthetic-monitor/science42-session.json

HEADLESS=true
MAX_TASK_MS=75000

# AdvancedResearch 数据集默认通过 WebSocket 直连；页面模拟保留为 ask:advanced-research-ui。
# WS_ANSWER_TIMEOUT_MS=900000
# WS_PERSISTENCE_TIMEOUT_MS=60000

# ── 上报 Admin：整项目共用一套（所有 suites / runners 同一 Runner）──
# 在 Admin 建 1 个监控项拿一次凭证即可，不必每个测试配一次。
# 不填则只写 results/ 本地结果。
ADMIN_URL=
ADMIN_RUNNER_ID=
ADMIN_RUNNER_TOKEN=

# 兼容旧变量名（可选，与上面三选一即可）
# SYNTHETIC_MONITOR_REPORT_URL=
# SYNTHETIC_MONITOR_RUNNER_ID=
# SYNTHETIC_MONITOR_RUNNER_TOKEN=
