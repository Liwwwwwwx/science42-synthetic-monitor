# ── 本项目固定测 https://www.science42.tech（见 shared/config/project.mjs）──
# 一般只需填登录账号；BASE_URL 可省略。

SCIENCE42_USER=
SCIENCE42_PASSWORD=

# 可选覆盖（默认已是线上站）
# SCIENCE42_BASE_URL=https://www.science42.tech
# SCIENCE42_STORAGE_STATE=shared/auth/.auth/science42.json

HEADLESS=true
MAX_TASK_MS=75000

# ── 上报 Admin：整项目共用一套（所有 suites / runners 同一 Runner）──
# 在 Admin 建 1 个监控项拿一次凭证即可，不必每个测试配一次。
# 不填则只写 results/ 本地结果。
ADMIN_URL=
ADMIN_RUNNER_ID=
ADMIN_RUNNER_TOKEN=

# 兼容旧变量名（可选，与上面三选一即可）
# SYNTHETIC_MONITOR_REPORT_URL=
# SYNTHETIC_MONITOR_RUNNER_ID=
# SYNTHETIC_MONITOR_RUNNER_TOKEN=
