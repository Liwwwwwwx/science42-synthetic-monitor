# Copy to /etc/science42-synthetic-monitor/monitor.env, then set:
# chown root:synthetic-monitor /etc/science42-synthetic-monitor
# chmod 750 /etc/science42-synthetic-monitor
# chown root:synthetic-monitor /etc/science42-synthetic-monitor/monitor.env
# chmod 640 /etc/science42-synthetic-monitor/monitor.env
# Do not commit the copied file or a real Runner Token.
SCIENCE42_MONITOR_URL=https://www.science42.tech
SCIENCE42_ENTRY_PATH=/#/cases
SCIENCE42_CHAT_PATH=/#/chat
# Product login state belongs in one protected profiles/<profile>.env file per account.
# Do not put SCIENCE42_TOKEN, SCIENCE42_USER_NAME, SCIENCE42_USER, or SCIENCE42_PASSWORD here.
# Production Runner never enables SCIENCE42_ALLOW_RELOGIN.
HEADLESS=true
MAX_TASK_MS=75000
MONITOR_ARTIFACT_DIR=/var/lib/science42-synthetic-monitor/artifacts
MONITOR_SPOOL_DIR=/var/lib/science42-synthetic-monitor/spool
SYNTHETIC_MONITOR_REPORT_URL=https://admin.example.com
SYNTHETIC_MONITOR_RUNNER_ID=
SYNTHETIC_MONITOR_RUNNER_TOKEN=
