[Unit]
Description=Science42 synthetic browser monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=synthetic-monitor
Group=synthetic-monitor
WorkingDirectory=/opt/science42-synthetic-monitor
EnvironmentFile=/etc/science42-synthetic-monitor/monitor.env
Environment=HOME=/var/lib/science42-synthetic-monitor
Environment=XDG_CACHE_HOME=/var/lib/science42-synthetic-monitor/cache
ExecStart=/usr/bin/npm run monitor:core
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/science42-synthetic-monitor /opt/science42-synthetic-monitor/artifacts
