# Copy this file to /etc/science42-synthetic-monitor/profiles/<profile>.env.
# The backend selects the file only from its fixed profile allowlist.
# owner root:synthetic-monitor, mode 0640; directory mode 0750.
# Never commit a copied file or put its values in Admin database/logs.

# Required WS login state. Refresh manually when it expires.
SCIENCE42_TOKEN=
SCIENCE42_USER_NAME=
SCIENCE42_ALLOW_RELOGIN=false

# Each account must use an independent storage state and flock.
SCIENCE42_STORAGE_STATE=/var/lib/science42-synthetic-monitor/<profile>.json
SYNTHETIC_SHARED_LOCK_FILE=/tmp/science42-synthetic-monitor-<profile>.lock
