{
  "name": "science42-test-suite",
  "private": true,
  "type": "module",
  "scripts": {
    "pw:install": "playwright install chromium",
    "auth:setup": "node --env-file=.env shared/auth/auth-setup.mjs",
    "test:basic": "playwright test suites/basic-flow --project=chromium --workers=1",
    "monitor:basic": "BASIC_FLOW_MODE=quick sh scripts/with-shared-monitor-lock.sh playwright test suites/basic-flow --project=chromium --workers=1",
    "test:case-catalog": "playwright test suites/case-catalog --project=chromium --workers=1",
    "test:markdown": "playwright test suites/markdown-render --project=chromium --workers=1",
    "test:batch-cases": "playwright test suites/batch-cases/batch-case-runner.spec.mjs --project=chromium --workers=1",
    "test:case": "playwright test suites/batch-cases/batch-case-runner.spec.mjs --project=chromium --workers=1",
    "run:cases": "sh scripts/with-shared-monitor-lock.sh node scripts/run-cases.mjs",
    "run:cases-ws": "sh scripts/with-shared-monitor-lock.sh node scripts/run-cases-ws.mjs",
    "run:cases-ws:local": "sh scripts/with-shared-monitor-lock.sh node --env-file=.env scripts/run-cases-ws.mjs",
    "preview:case-output": "node scripts/read-case-output.mjs",
    "test:quick": "node scripts/run-quick-suites.mjs",
    "test:batch-all": "node --env-file=.env suites/batch-cases/run-all-case-categories.mjs",
    "probe:team-api": "node --env-file=.env probes/team-api/team-interface-probe.mjs",
    "ask:advanced-research": "sh scripts/with-shared-monitor-lock.sh node scripts/ask-advanced-research-ws.mjs",
    "ask:advanced-research:local": "sh scripts/with-shared-monitor-lock.sh node --env-file=.env scripts/ask-advanced-research-ws.mjs",
    "ask:advanced-research-ui": "sh scripts/with-shared-monitor-lock.sh node --env-file=.env scripts/ask-advanced-research.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv": "^17.4.2"
  }
}
