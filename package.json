{
  "name": "science42-test-suite",
  "private": true,
  "type": "module",
  "scripts": {
    "pw:install": "playwright install chromium",
    "auth:setup": "node playwright/auth-setup.mjs",
    "test:s10": "playwright test playwright/s10.spec.mjs --project=chromium",
    "test:s30b": "playwright test playwright/s30b.spec.mjs --project=chromium --workers=1",
    "capture:responses": "playwright test playwright/capture-responses.spec.mjs --project=chromium --workers=1",
    "test:core-regression": "playwright test playwright/core-flow-regression.spec.mjs --project=chromium --workers=1",
    "probe:team-api": "node api/team-interface-probe.mjs",
    "test:case-catalog": "playwright test playwright/case-catalog.spec.mjs --project=chromium --workers=1",
    "test:sr30": "playwright test playwright/session-recovery.spec.mjs --project=chromium",
    "monitor": "powershell -ExecutionPolicy Bypass -File monitor/run-monitor.ps1",
    "monitor:core": "node monitor/core-flow-monitor.mjs",
    "monitor:core:admin-local": "node monitor/run-admin-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
